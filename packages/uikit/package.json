{
  "name": "@koala/uikit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./globals.css": "./dist/styles/globals.css",
    "./tailwind.config": {
      "types": "./dist/tailwind.config.d.ts",
      "default": "./dist/tailwind.config.js"
    }
  },
  "scripts": {
    "build": "tsc -b && npm run copy:css && npm run copy:templates && npm run copy:tailwind",
    "dev": "tsc --watch",
    "copy:css": "mkdir -p dist/styles && cp src/styles/globals.css dist/styles/globals.css",
    "copy:templates": "mkdir -p dist/templates && cp src/templates/*.hbs dist/templates/ 2>/dev/null || true",
    "copy:tailwind": "cp src/tailwind.config.ts dist/tailwind.config.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@koala/shared": "*",
    "@koala/types": "*",
    "@radix-ui/react-slot": "^1.2.4",
    "chakra-react-select": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "handlebars": "^4.7.8",
    "lucide-react": "^0.560.0",
    "react-dynamic-mount": "^0.1.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^16.1.0",
    "typescript": "^5"
  }
}
